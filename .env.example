# Copy this file to .env through scripts/bootstrap.ps1 or scripts/bootstrap.sh.
# Never commit .env. The bootstrap scripts replace the secret placeholder.
APP_SECRET_KEY=GENERATE_WITH_BOOTSTRAP_DO_NOT_USE

# The default only accepts connections from this computer. Set an explicit
# private-LAN address (for example, 192.168.1.25) only when household access is
# intended. Do not use 0.0.0.0 on an untrusted network.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Host directories mounted into the containers. Relative paths resolve from
# the directory containing compose.yml. MEDIA_PATH is always mounted read-only.
DATA_PATH=./runtime/data
DATABASE_PATH=./runtime/database
ARTWORK_PATH=./runtime/artwork
TEMP_PATH=./runtime/temp
MEDIA_PATH=./media
BACKUP_PATH=./backups

# Container identity. The Linux bootstrap writes the invoking user's IDs so
# bind-mounted data remains owned by that user. Docker Desktop may keep 1000.
PUID=1000
PGID=1000

# Container ceilings (in addition to FFmpeg thread, slot and storage limits).
BACKEND_CPUS=4.0
BACKEND_MEMORY=2g
WORKER_CPUS=1.0
WORKER_MEMORY=1g
FRONTEND_CPUS=2.0
FRONTEND_MEMORY=1g
PROXY_CPUS=1.0
PROXY_MEMORY=256m

# Runtime behavior
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL=1.0
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
SCAN_BATCH_SIZE=50
FFPROBE_TIMEOUT_SECONDS=45
JOB_STALE_MINUTES=15
BACKUP_RETENTION_DAYS=30

# This is deliberately off. Enabling future integrations also requires an
# Owner-controlled application setting and an explicit network configuration.
OUTBOUND_INTEGRATIONS_ENABLED=false

# Local playback: bounds/units are documented in docs/configuration.md.
PLAYBACK_SESSION_TIMEOUT_SECONDS=90
PLAYBACK_MAX_STREAMS=8
PLAYBACK_STREAMS_PER_USER=2
PLAYBACK_WATCHED_THRESHOLD=90
PLAYBACK_MINIMUM_WATCH_SECONDS=30
PLAYBACK_HISTORY_DAYS=365
TRANSCODE_MAX_PROCESSES=2
TRANSCODE_THREADS=2
TRANSCODE_MAX_HEIGHT=2160
TRANSCODE_MAX_BITRATE_KBPS=12000
TRANSCODE_MAX_STORAGE_MB=4096
TRANSCODE_STARTUP_TIMEOUT_SECONDS=45
# software, qsv, nvenc, or amf; an Owner test encode must succeed to enable hardware.
TRANSCODE_HARDWARE=software
